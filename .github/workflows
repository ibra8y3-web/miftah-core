name: apply-update
on:
  push:
    paths:
      - "update.zip"
permissions:
  contents: write
  actions: write
jobs:
  apply:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unpack, commit, and start the build
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if [ ! -f update.zip ]; then echo "No update.zip, nothing to do"; exit 0; fi
          unzip -o update.zip -x '.github/*'
          rm -f update.zip
          git config user.name "miftah-update"
          git config user.email "miftah-update@users.noreply.github.com"
          git add -A
          if git diff --cached --quiet; then echo "Nothing to commit"; else git commit -m "Apply update.zip"; git push; fi
          gh workflow run build.yml